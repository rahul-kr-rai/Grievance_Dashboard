<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Citizen Access | Premium Portal</title>
  
  <!-- Modern Fonts and Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --bg-dark: #ffffff;
      --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      --glass-bg: #ffffff;
      --glass-border: #cbd5e1;
      --accent: #10b981;
      --accent-hover: #059669;
      --text-main: #1f2937;
      --text-muted: #64748b;
      --input-bg: #f1f5f9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
    }

    /* Abstract background blobs for premium feel */
    .blob {
      position: absolute;
      filter: blur(80px);
      z-index: -1;
      opacity: 0.4;
      border-radius: 50%;
    }
    .blob.emerald { width: 400px; height: 400px; background: #e2e8f0; top: -100px; left: -100px; }
    .blob.indigo { width: 500px; height: 500px; background: #cbd5e1; bottom: -200px; right: -100px; }

    /* Scene Wrapper for Animations */
    .scene {
      position: relative;
      width: 100%;
      max-width: 650px;
      padding: 20px;
      perspective: 1000px;
    }

    /* Glassmorphism Card Base */
    .glass-card {
      background: var(--glass-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      padding: 50px 40px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      position: absolute;
      top: 0; left: 0; right: 0;
      
      opacity: 0;
      pointer-events: none;
      transform: translateY(20px) scale(0.95);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .glass-card.active {
      position: relative;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
    }

    h2 {
      font-size: 2rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 10px;
      color: var(--text-main);
    }

    p.subtitle {
      text-align: center;
      color: var(--text-muted);
      margin-bottom: 40px;
      font-weight: 300;
    }

    /* Grid layout for massive forms */
    .grid-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      flex-direction: column;
    }
    
    .input-wrapper.full-span {
      grid-column: span 2;
    }

    .input-wrapper i {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      left: 18px;
      color: var(--text-muted);
      font-size: 1.1rem;
      transition: color 0.3s ease;
    }

    input, select {
      background: var(--input-bg);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 16px 16px 16px 50px;
      color: var(--text-main);
      font-size: 1rem;
      width: 100%;
      outline: none;
      transition: all 0.3s ease;
      appearance: none;
    }
    
    /* Select styling */
    select {
      cursor: pointer;
    }
    select option {
      background: #ffffff;
      color: var(--text-main);
    }

    input:focus, select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
      background: #ffffff;
    }
    
    input:focus + i, input:focus ~ i, select:focus ~ i {
      color: var(--accent);
    }

    /* Dynamic Labeling */
    ::-webkit-input-placeholder { color: #475569; }

    /* Gender Sub-Grid */
    .gender-wrapper {
      grid-column: span 2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      margin: 10px 0;
      padding: 15px;
      background: var(--input-bg);
      border-radius: 12px;
      border: 1px solid var(--glass-border);
    }
    
    .gender-wrapper span.label {
      color: var(--text-muted);
      font-weight: 600;
      margin-right: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .radio-box {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      color: var(--text-main);
    }
    
    .radio-box input[type="radio"] {
      width: 18px;
      height: 18px;
      margin: 0;
      padding: 0;
      accent-color: var(--accent);
      cursor: pointer;
    }

    /* Submit Action */
    .action-btn {
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 12px;
      padding: 16px;
      font-size: 1.1rem;
      font-weight: 600;
      width: 100%;
      cursor: pointer;
      margin-top: 30px;
      transition: all 0.3s ease;
      box-shadow: 0 10px 20px -10px var(--accent);
    }
    
    .action-btn:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
      box-shadow: 0 15px 25px -10px var(--accent);
    }
    .action-btn:active {
      transform: translateY(1px);
    }

    /* Footer Swapper */
    .footer-swap {
      text-align: center;
      margin-top: 25px;
      color: var(--text-muted);
      font-size: 0.95rem;
    }
    
    .footer-swap a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
      margin-left: 5px;
      cursor: pointer;
      transition: color 0.3s ease;
    }
    .footer-swap a:hover {
      color: #34d399;
      text-decoration: underline;
    }

    /* Responsiveness */
    @media (max-width: 600px) {
      .grid-container {
        grid-template-columns: 1fr;
      }
      .input-wrapper.full-span {
        grid-column: span 1;
      }
      .gender-wrapper {
        grid-column: span 1;
        flex-direction: column;
        gap: 10px;
      }
      .glass-card {
        padding: 40px 25px;
      }
    }
  </style>
</head>
<body>

  <div class="blob emerald"></div>
  <div class="blob indigo"></div>

  <div class="scene">
    
    <!-- LOGIN VIEW -->
    <div class="glass-card active" id="pane-login">
      <h2>Welcome Back</h2>
      <p class="subtitle">Securely access your citizen dashboard</p>

      <div class="grid-container" style="display: flex; flex-direction: column; gap: 20px;">
        <div class="input-wrapper">
          <input type="email" id="login-email" placeholder="Email Address" required autocomplete="off">
          <i class="fa-solid fa-envelope"></i>
        </div>
        
        <div class="input-wrapper">
          <input type="password" id="login-password" placeholder="Secure Password" required>
          <i class="fa-solid fa-lock"></i>
        </div>
      </div>

      <button class="action-btn" onclick="executeLogin()">Access Dashboard</button>

      <div class="footer-swap">
        New here? <a onclick="swapPanes('pane-register')">Create an account</a>
      </div>
    </div>

    <!-- REGISTRATION VIEW -->
    <div class="glass-card" id="pane-register">
      <h2>Citizen Enrollment</h2>
      <p class="subtitle">Enter your detailed demographic records</p>

      <div class="grid-container">
        
        <div class="input-wrapper">
          <input type="text" id="reg-name" placeholder="Full Name" required autocomplete="off">
          <i class="fa-solid fa-user"></i>
        </div>
        
        <div class="input-wrapper">
          <input type="tel" id="reg-mobile" placeholder="Mobile Number" required autocomplete="off">
          <i class="fa-solid fa-mobile-screen"></i>
        </div>

        <div class="input-wrapper">
          <input type="email" id="reg-email" placeholder="Email Address" required autocomplete="off">
          <i class="fa-solid fa-envelope"></i>
        </div>

        <div class="input-wrapper">
          <input type="password" id="reg-password" placeholder="Secure Password" required>
          <i class="fa-solid fa-lock"></i>
        </div>

        <div class="input-wrapper">
          <select id="reg-state" onchange="updateCitizenDistricts()">
            <option value="" disabled selected>Select State</option>
          </select>
          <i class="fa-solid fa-gavel"></i>
        </div>

        <div class="input-wrapper">
          <select id="reg-district">
            <option value="" disabled selected>Select District</option>
          </select>
          <i class="fa-solid fa-building-columns"></i>
        </div>

        <div class="gender-wrapper">
          <span class="label"><i class="fa-solid fa-venus-mars"></i> Gender:</span>
          <label class="radio-box"><input type="radio" name="gender" value="Male"> Male</label>
          <label class="radio-box"><input type="radio" name="gender" value="Female"> Female</label>
          <label class="radio-box"><input type="radio" name="gender" value="Other"> Other</label>
        </div>

      </div>

      <button class="action-btn" onclick="executeRegister()">Complete Registration</button>

      <div class="footer-swap">
        Already registered? <a onclick="swapPanes('pane-login')">Login securely</a>
      </div>
    </div>

  </div>

  <script>
    // Seamless UI Swap Logic
    function swapPanes(targetId) {
      document.querySelectorAll('.glass-card').forEach(card => {
        card.classList.remove('active');
      });
      document.getElementById(targetId).classList.add('active');
    }

    // Backend Execution Hook: Login
    async function executeLogin() {
      const email = document.getElementById('login-email').value;
      const password = document.getElementById('login-password').value;
      
      if(!email || !password) return alert("Please supply both credentials.");

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        
        const data = await res.json();
        if(res.ok) {
           window.location.href = "Dashbord.html"; // Dynamic redirect hooked to root
        } else {
           alert(data.error || "Authentication voided.");
        }
      } catch(err) {
        alert("Server failed to respond.");
      }
    }

    // Backend Execution Hook: Register
    async function executeRegister() {
      const name = document.getElementById('reg-name').value;
      const mobile = document.getElementById('reg-mobile').value;
      const email = document.getElementById('reg-email').value;
      const password = document.getElementById('reg-password').value;
      const state = document.getElementById('reg-state').value;
      const district = document.getElementById('reg-district').value;
      
      const genderEle = document.querySelector('input[name="gender"]:checked');
      const gender = genderEle ? genderEle.value : '';
      
      if(!email || !password || !name || !mobile || !state || !district || !gender) {
         return alert("Missing Data. Please verify all fields are populated.");
      }

      try {
        // Transmitting data natively to the rewritten Mongoose Backend logic
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, mobile, name, state, district, gender, role: 'citizen' }) // Admin locked 
        });
        
        const data = await res.json();
        if(res.ok) {
           alert("Biometric sequence accepted. Welcome to the grid.");
           swapPanes('pane-login');
           // Clean old inputs securely natively
           document.getElementById('login-email').value = email;
           document.getElementById('login-password').value = password;
        } else {
           alert(data.error || "Enrollment rejected.");
        }
      } catch(err) {
        alert("Server transmission failed.");
      }
    }

    // Authentic Indian Geographic Cascading Logic
    const geoData = {
      "Maharashtra": ["Mumbai", "Pune", "Nagpur", "Thane", "Nashik"],
      "Bihar": ["Patna", "Gaya", "Muzaffarpur", "Bhagalpur", "Darbhanga"],
      "Uttar Pradesh": ["Lucknow", "Kanpur", "Varanasi", "Agra", "Noida"],
      "Karnataka": ["Bengaluru", "Mysuru", "Hubballi", "Mangaluru", "Belagavi"],
      "Tamil Nadu": ["Chennai", "Coimbatore", "Madurai", "Tiruchirappalli", "Salem"]
    };

    window.onload = function() {
      const stateSelect = document.getElementById("reg-state");
      for (let state in geoData) {
        stateSelect.add(new Option(state, state));
      }
    };

    function updateCitizenDistricts() {
      const stateSelect = document.getElementById("reg-state");
      const districtSelect = document.getElementById("reg-district");
      const selectedState = stateSelect.value;
      
      districtSelect.innerHTML = '<option value="" disabled selected>Select District</option>';
      if (geoData[selectedState]) {
        geoData[selectedState].forEach(district => {
          districtSelect.add(new Option(district, district));
        });
      }
    }
  </script>
</body>
</html>
