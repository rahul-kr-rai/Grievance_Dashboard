<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/admin-head') %>
    <% if (locals.pageTitle) { %><title><%= pageTitle %></title><% } %>
    <% if (locals.extraHead) { %><%- extraHead %><% } %>
</head>
<body>
    <%- include('../partials/admin-header') %>
    <div class="main-content">
        <%- include('../partials/admin-sidebar') %>
        
        <div class="content">
            <h2><i class="fas fa-chart-bar"></i> Analytics & Performance Reports</h2>
            
            <div class="filter-actions-row">
                <div class="search-filter">
                    <select class="filter-select">
                        <option value="">Select Timeframe</option>
                        <option value="month">Last 30 Days</option>
                        <option value="quarter">Last Quarter</option>
                        <option value="year">Last Year</option>
                    </select>
                    <select class="filter-select">
                        <option value="">Select Department</option>
                        <option value="deptA">Dept A</option>
                        <option value="deptB">Dept B</option>
                    </select>
                </div>
                <button class="export-button"><i class="fas fa-file-pdf"></i> Generate PDF Report</button>
            </div>
            
            <section class="charts-row">
                <div class="chart-box category-chart">
                    <h3>Resolution Time Distribution (Days)</h3>
                    <div style="height: 300px;"><canvas id="resTimeChart"></canvas></div> 
                </div>
                <div class="chart-box time-chart">
                    <h3>Officer Performance Ranking</h3>
                    <div style="height: 300px;"><canvas id="performanceChart"></canvas></div>
                </div>
            </section>
            
            <section class="charts-row">
                <div class="chart-box category-chart" style="flex: 0 0 40%;"> 
                    <h3>Escalation Rate by Category</h3>
                    <div style="height: 250px;"><canvas id="escalationChart"></canvas></div>
                </div>
                <div class="chart-box time-chart" style="flex: 0 0 58%;">
                    <h3>Unresolved Complaints Trend</h3>
                    <div style="height: 250px;"><canvas id="unresolvedChart"></canvas></div>
                </div>
            </section>
        </div>
    </div>
    </div>
    
    <%- include('../partials/footer') %>
</body>
</html>