<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Escalated Complaints</title>
    <link rel="stylesheet" href="style.css"> 
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
    <script src="main.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="dynamicAdmin.js"></script>
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="logo">
                <a href="AdminDashboard.html"><img src="/Frontend/src/image/logo.png" alt="Logo" style="height:60px; width: auto;"></a>
            </div>
            <nav class="nav-links">
                <h1>Welcome Admin OfficerName</h1> 
            </nav>
            <div class="profile-section">
                <a href="#" class="login-btn"><i class="fas fa-bell" style="color: #fbff00; font-size: 250%;"></i></a>
                <a href="#" class="login-btn"><i class="fas fa-user-circle" style="color: #ffffff; font-size: 250%;"></i></a>
            </div>
        </div>
    </header>

    <div class="main-content">
        <aside class="sidebar">
            <div class="sidebar-container">
                <h1 style="color: #00009c;"><i class="fas fa-chart-line"></i> Dashboard</h1>
                <br>
                <div class="links">
                    <a href="AdminDashboard.html"><i class="fas fa-chart-line"></i> Dashboard</a>
                    <a href="NewComplaints.html"><i class="fas fa-plus-circle"></i> New Complaints</a>
                    <a href="AssignedComplaints.html"><i class="fas fa-tasks"></i> Assigned Complaints</a>
                    <a href="PendingComplaints.html"><i class="fas fa-hourglass-half"></i> Pending Complaints</a>
                    <a href="ResolvedComplaints.html"><i class="fas fa-check-circle"></i> Resolved Complaints</a>
                    
                    <a href="EscalatedComplaints.html" class="active-link"><i class="fas fa-exclamation-triangle"></i> Escalated Complaints</a>
    
                    <a href="AnalyticsReports.html"><i class="fas fa-chart-bar"></i> Analytics / Reports</a>
                    <a href="/Frontend/index.html"><i class="fas fa-sign-out-alt"></i> Logout</a>
                </div>
            </div>
        </aside>
        
        <div class="content">
            <h2><i class="fas fa-exclamation-triangle"></i> Critical & Escalated Cases</h2>
            
            <div class="filter-actions-row">
                <div class="search-filter">
                    <input type="text" placeholder="Search by Officer or Priority..." class="search-input">
                    <select class="filter-select">
                        <option value="">Filter by Escalation Level</option>
                        <option value="level1">Level 1 (Internal)</option>
                        <option value="level2">Level 2 (Director)</option>
                        <option value="level3">Level 3 (Minister)</option>
                    </select>
                </div>
                <button class="contact-button"><i class="fas fa-headset"></i> Contact Authority</button>
            </div>
            
            <section class="table-row">
                <table>
                    <thead>
                        <tr>
                            <th>Complaint ID</th>
                            <th>Citizen Name</th>
                            <th>Category</th>
                            <th>Escalation Level</th>
                            <th>Raised By</th>
                            <th>Days Open</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#12358</td>
                            <td>Vikram Patel</td>
                            <td>Corruption</td>
                            <td class="level-high">Level 3</td>
                            <td>Director A</td>
                            <td class="days-open-high">45</td>
                            <td><button class="action-btn-critical">Immediate Review</button></td>
                        </tr>
                        <tr>
                            <td>#12359</td>
                            <td>Neha Sharma</td>
                            <td>Infrastructure Failure</td>
                            <td class="level-medium">Level 2</td>
                            <td>Officer B</td>
                            <td class="days-open-medium">15</td>
                            <td><button class="action-btn-critical">Immediate Review</button></td>
                        </tr>
                        <tr>
                            <td>#12360</td>
                            <td>Rajesh Kumar</td>
                            <td>Misconduct</td>
                            <td class="level-low">Level 1</td>
                            <td>Officer C</td>
                            <td class="days-open-low">3</td>
                            <td><button class="action-btn-view">View Progress</button></td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </div>
    </div>
    
    <footer class="footer">
        <div class="footer-container">
            <p>&copy; 2025 TDP Project All Rights Reserved</p>
        </div>
    </footer>
</body>
</html>